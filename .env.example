# Copy to .env (root for compose) and apps/api/.env
NODE_ENV=development
DATABASE_URL=postgresql://syntrix:syntrix_dev_pw@localhost:5432/syntrix?schema=public
REDIS_URL=redis://localhost:6379
API_PORT=3001
WEB_ORIGIN=http://localhost:5173
# true only behind HTTPS. HTTP Hostinger VPS must keep false or login cookies won't stick.
COOKIE_SECURE=false
COOKIE_SECRET=change-me-32chars-minimum-secret!!
JWT_ACCESS_SECRET=change-me-access-secret-32chars!!
# 32-byte base64 key for provider-credential / KYC field encryption (openssl rand -base64 32)
ENCRYPTION_KEY=MDEyMzQ1Njc4OTAyMzQ1Njc4OTAxMjM0NTY3ODkwMTI=
# local = disk (Hostinger-friendly). s3 = MinIO/S3.
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=/data/uploads
PUBLIC_API_URL=http://201.18.196.182:8080
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=syntrix-kyc-private
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin_dev_pw
MOCK_PROVIDER_MODE=true
# Personal mode: yeh portal sirf tumhara hai (ek hi downstream portal, multiple upstream APIs).
# true = merchant owner login se hi providers/keys/switch sab manage hoga. Multi-merchant SaaS ke liye false rakho.
PERSONAL_MODE=true
VERIFICATION_PROVIDER=mock
OTP_PROVIDER=mock
MALWARE_SCANNER=mock
POSTGRES_USER=syntrix
POSTGRES_PASSWORD=syntrix_dev_pw
POSTGRES_DB=syntrix
